# Grok API key (default translator — recommended, fast & cheap)
# Get key at https://console.x.ai — keys start with "xai-"
GROK_API_KEYS=xai-your_grok_key_here

# Gemini / Vertex keys (fallback, comma-separated)
GEMINI_API_KEYS=key1,key2,key3
VERTEX_API_KEYS=vertex_key1,vertex_key2

# Or single key (legacy, still works)
# GEMINI_API_KEY=your_gemini_api_key_here
# VERTEX_API_KEY=your_vertex_api_key_here

# Optional startup guards for Vast/GPU deploy
# REQUIRE_TRANSLATION_KEYS=1   # fail start if all translation keys are missing
# REQUIRE_GROK=1               # fail start if no valid Grok key is found
# REQUIRE_CUDA=1               # fail start if CUDA GPU is not visible
